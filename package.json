{
  "name": "supersendtx-nodemailer",
  "version": "0.9.0",
  "description": "Nodemailer transport for SuperSend TX transactional email (HTTP API, not SMTP)",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Super-Send/supersendtx-nodemailer.git"
  },
  "homepage": "https://docs.supersendtx.com/frameworks/node",
  "bugs": {
    "url": "https://github.com/Super-Send/supersendtx-nodemailer/issues"
  },
  "keywords": [
    "nodemailer",
    "nodemailer-transport",
    "email",
    "transactional",
    "transport",
    "supersend",
    "supersendtx",
    "smtp"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "nodemailer": ">=6.0.0",
    "supersendtx": ">=0.9.0"
  },
  "devDependencies": {
    "supersendtx": "0.9.0",
    "tsup": "^8.5.0",
    "typescript": "^5",
    "vitest": "^3.2.4"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  }
}
